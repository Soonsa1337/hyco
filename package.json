{
  "name": "hyco",
  "productName": "Hyco",
  "version": "1.14.0",
  "description": "Private Voice-, Chat- und Streaming-App",
  "author": "Hyco",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "build:native": "cd native/hyco-audio && node-gyp rebuild",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac"
  },
  "build": {
    "appId": "app.hyco.desktop",
    "publish": null,
    "protocols": [
      {
        "name": "Hyco",
        "schemes": [
          "hyco"
        ]
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "native/hyco-audio/index.js",
      "native/hyco-audio/build/Release/*.node"
    ],
    "asarUnpack": [
      "native/**/*.node"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Hyco braucht das Mikrofon für Sprachkanäle."
      }
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "livekit-client": "^2.22.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^12.4.0",
    "vite": "^8.3.2",
    "wait-on": "^9.5.1"
  }
}
